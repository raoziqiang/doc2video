{
  "$defs": {
    "ArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "相对 Job 根的路径",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "mime": {
          "minLength": 1,
          "title": "Mime",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "mime"
      ],
      "title": "ArtifactEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "staging_path": {
      "minLength": 1,
      "title": "Staging Path",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ArtifactEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "command_argv": {
      "description": "实际执行的命令参数数组(审计用)",
      "items": {
        "type": "string"
      },
      "title": "Command Argv",
      "type": "array"
    },
    "bgm_mix_argv": {
      "description": "BGM 混音命令参数数组(审计用;无 BGM 时为空)",
      "items": {
        "type": "string"
      },
      "title": "Bgm Mix Argv",
      "type": "array"
    },
    "fonts": {
      "description": "字幕使用的字体记录(可审计/可复现, S2.5 L-04)",
      "items": {
        "type": "string"
      },
      "title": "Fonts",
      "type": "array"
    },
    "timeline_ref_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "引用的 render_timeline.json 内容哈希",
      "title": "Timeline Ref Sha256"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    }
  },
  "required": [
    "staging_path",
    "entries",
    "committed_at"
  ],
  "title": "RenderManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doc2video.local/schemas/render_manifest.schema.json"
}
